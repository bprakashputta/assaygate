# Needed only for live runs (judge calibration, the demo classifier). Tests never call the API.
ANTHROPIC_API_KEY=
# Hard spend cap enforced by the shared ledger before every model call (USD).
ASSAYGATE_SPEND_CAP_USD=5.0
ASSAYGATE_LEDGER=.assaygate/spend.jsonl
ASSAYGATE_CACHE=.assaygate/cache.sqlite
# Demo classifier
PROMPT_VERSION=v1
